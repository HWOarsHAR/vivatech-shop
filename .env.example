# ===== Локальная разработка (PostgreSQL на вашем компьютере) =====
DJANGO_DEBUG=1
DB_NAME=products_db
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# ===== Netrun (задаются в настройках приложения, не коммитятся в Git) =====
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=длинная-случайная-строка-50+-символов      # ОБЯЗАТЕЛЬНО
# DB_NAME=default_db            # из карточки управляемой БД PostgreSQL
# DB_USER=gen_user
# DB_PASSWORD=пароль-из-карточки-БД
# DB_HOST=адрес-из-карточки-БД
# DB_PORT=5432
# SITE_URL=https://ваш-домен.twc1.net                        # после получения адреса приложения
# ADMIN_EMAIL=admin@ваш-домен.ru
# ADMIN_PASSWORD=надёжный-пароль-от-8-символов
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require   # альтернатива набору DB_*
